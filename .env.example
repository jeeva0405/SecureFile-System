# ── SecureDoc Audit System – Environment Variables ────────────────────────────
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# Path to the folder you want to monitor
MONITORED_DIR=C:\SecuredFolder

# Stakeholder Bot (receives full alerts with file name & actor)
STAKEHOLDER_BOT_TOKEN=your_stakeholder_bot_token_here
STAKEHOLDER_CHAT_IDS=chat_id_1,chat_id_2

# Public Ledger Bot (receives anonymised audit entries)
PUBLIC_BOT_TOKEN=your_public_bot_token_here
PUBLIC_CHAT_IDS=chat_id_1,chat_id_2,chat_id_3

# SQLite database file name (relative path)
DB_FILE=audit_logs.db
